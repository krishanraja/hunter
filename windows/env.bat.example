@echo off
REM Copy this file to env.bat and fill in the two values.
REM These are the ONLY two secrets hunter needs; everything else lives in
REM Supabase and is read at runtime. Do not commit env.bat.
set SUPABASE_URL=https://YOUR-PROJECT.supabase.co
set SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
