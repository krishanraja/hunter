{
  "permissions": {
    "allow": [
      "Bash(git clone https://github.com/krishanraja/hunter)",
      "Bash(git clone https://github.com/krishanraja/hunter.git)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(pip install -e hunter)",
      "Bash(pip install -e .)",
      "Bash(pip install -e .[dev])",
      "Bash(python -m pip install -e hunter)",
      "Bash(python -m pip install -e .)",
      "Bash(python -m hunter.run:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -c:*)",
      "Bash(python -:*)",
      "Bash(curl -sS https://api.github.com/:*)",
      "Bash(curl -sS https://api.vercel.com/:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Dd]rive.*__(create_file|copy_file|update_file)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/drive_guard.py\""
          }
        ]
      }
    ]
  }
}
